# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the client

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM=".ppl Solutions <hello@pplsolutionsinc.com>"   # must be a verified domain/sender
# Both accept ONE address or SEVERAL, separated by commas or semicolons:
#   CONTACT_NOTIFY_EMAIL="sales@pplsolutionsinc.com, ops@pplsolutionsinc.com"
# Malformed entries are dropped so a single typo can't kill the whole send.
# NOTE: multi-recipient delivery requires a verified sending domain — while
# RESEND_FROM is the onboarding@resend.dev sandbox sender, Resend only
# delivers to the account's own signup address, whatever is listed here.
# Production values (client-confirmed 2026-07-30). Do NOT set these until the
# sending domain is verified — until then Resend rejects them and the internal
# notification is lost silently.
#   CONTACT_NOTIFY_EMAIL=sales@pplsolutionsinc.com
#   JOBS_NOTIFY_EMAIL=careers@pplsolutionsinc.com
CONTACT_NOTIFY_EMAIL=               # internal address(es) that receive form notifications
JOBS_NOTIFY_EMAIL=                  # optional — job applications go here instead; falls back to CONTACT_NOTIFY_EMAIL

# Site
NEXT_PUBLIC_SITE_URL=https://www.pplsolutionsinc.com

# Staging only — set these to password-protect a preview deployment and mark it
# noindex. Leave BOTH unset in production so the site is publicly reachable.
STAGING_USER=ppl
STAGING_PASSWORD=

# Drops ONLY the password prompt, so shared links are clickable by anyone while
# STAGING_PASSWORD stays set — robots.txt keeps search engines out, the
# x-robots-tag: noindex header stays on, and inquiries / page views are still
# stamped as staging. Use this to share real links from a preview deployment
# without letting it into the search index. Has no effect once STAGING_PASSWORD
# is unset. NOTE: robots.txt is prerendered, so changing this needs a rebuild.
STAGING_PUBLIC=

# --- Cloudflare Turnstile (form anti-abuse) ---
# Create a Managed widget at Cloudflare > Turnstile. Hostnames must list every
# host the forms are served from - Turnstile matches EXACTLY and does not
# inherit subdomains: w2.pplsolutionsinc.com, www.pplsolutionsinc.com,
# pplsolutionsinc.com, localhost
# Leave BOTH unset to disable Turnstile entirely; the forms then behave as they
# did before it existed.
# NOTE: NEXT_PUBLIC_TURNSTILE_SITE_KEY is inlined at BUILD time - setting it
# requires a rebuild, not just a restart.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

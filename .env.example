# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the client

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM=".ppl Solutions <hello@pplsolutionsinc.com>"   # must be a verified domain/sender
# Both accept ONE address or SEVERAL, separated by commas or semicolons:
#   CONTACT_NOTIFY_EMAIL="sales@pplsolutionsinc.com, ops@pplsolutionsinc.com"
# Malformed entries are dropped so a single typo can't kill the whole send.
# NOTE: multi-recipient delivery requires a verified sending domain — while
# RESEND_FROM is the onboarding@resend.dev sandbox sender, Resend only
# delivers to the account's own signup address, whatever is listed here.
CONTACT_NOTIFY_EMAIL=               # internal address(es) that receive form notifications
JOBS_NOTIFY_EMAIL=                  # optional — job applications go here instead; falls back to CONTACT_NOTIFY_EMAIL

# Site
NEXT_PUBLIC_SITE_URL=https://www.pplsolutionsinc.com

# Staging only — set these to password-protect a preview deployment and mark it
# noindex. Leave BOTH unset in production so the site is publicly reachable.
STAGING_USER=ppl
STAGING_PASSWORD=
